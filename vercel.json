{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/api/backend/trpc/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}