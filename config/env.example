# Copie para .env somente no seu computador ou servidor.
# Nunca envie um arquivo .env preenchido ao Git ou a terceiros.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL: desenvolvimento local via docker-compose.yml.
DATABASE_URL=postgresql://tone_user:troque-esta-senha@localhost:5432/tone_marketing

# Autenticação externa: implemente o provedor escolhido antes de publicar o Admin.
AUTH_PROVIDER=external-oauth
ADMIN_EMAILS=carlosamorim@seplag.mt.gov.br
SESSION_SECRET=troque-por-um-segredo-longo-e-unico

# Proteções de aplicação: limites por endereço IP a cada 15 minutos.
API_RATE_LIMIT_PER_15_MIN=300
AUTH_RATE_LIMIT_PER_15_MIN=20

# Armazenamento persistente para uploads feitos após a publicação.
STORAGE_PROVIDER=s3-or-r2
S3_BUCKET=tone-marketing-assets
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:3000/media
